{
  "name": "contrejour",
  "version": "0.1.0",
  "private": true,
  "description": "An adversarial two-machine research task (worker and validator) built on agent-loop-studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justforyou16007/auto-dl-loop"
  },
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:framework": "npm --prefix agent-loop-studio run build",
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx",
    "test:python": "python3 -m unittest",
    "pack:contrejour": "npm run build && node tools/pack-contrejour.mjs",
    "lint": "oxlint src tools distribution tests",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
