{
  "name": "contrejour",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-loop framework on Claude Code, and the adversarial two-machine research task built on it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justforyou16007/auto-dl-loop"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:clean",
    "build:clean": "npm run clean && tsc -p tsconfig.json && npm run build:studio",
    "clean": "node tools/clean.mjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc --noEmit -p studio/tsconfig.json",
    "test": "tsx",
    "test:python": "python3 -m unittest",
    "pack:contrejour": "npm run build && node tools/pack-contrejour.mjs",
    "lint": "oxlint src tools distribution tests studio",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "prepare": "lefthook install",
    "build:studio": "vite build --config studio/vite.config.ts --logLevel warn"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xyflow/react": "12.12.1",
    "lefthook": "2.1.6",
    "lucide-react": "1.66.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
